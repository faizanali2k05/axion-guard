from collections.abc import Sequence
from typing import TypeAlias

NestedData: TypeAlias = float | int | Sequence[NestedData]

class Tensor:
    @property
    def shape(self) -> list[int]: ...
    @property
    def data(self) -> list[float]: ...
    @property
    def requires_grad(self) -> bool: ...
    @property
    def grad(self) -> Tensor | None: ...
    def __add__(self, other: Tensor) -> Tensor: ...
    def __sub__(self, other: Tensor) -> Tensor: ...
    def __mul__(self, other: Tensor) -> Tensor: ...
    def __truediv__(self, other: Tensor) -> Tensor: ...
    def matmul(self, other: Tensor) -> Tensor: ...
    def sum(self) -> Tensor: ...
    def mean(self) -> Tensor: ...
    def relu(self) -> Tensor: ...
    def sigmoid(self) -> Tensor: ...
    def tanh(self) -> Tensor: ...
    def reshape(self, shape: list[int]) -> Tensor: ...
    def transpose(self, axis_a: int = 0, axis_b: int = 1) -> Tensor: ...
    def cross_entropy(self, targets: list[int]) -> Tensor: ...
    def backward(self) -> None: ...
    def zero_grad(self) -> None: ...
    def _replace_data(self, data: list[float]) -> None: ...

def tensor(data: NestedData, *, requires_grad: bool = False) -> Tensor: ...

